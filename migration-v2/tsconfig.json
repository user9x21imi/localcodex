{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "types": [
      "node"
    ],
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid"
  },
  "include": [
    "*.ts",
    "*.tsx",
    "lib/*.ts"
  ]
}
